# Copy this file to .env and fill in your values.
# See comments in .env for instructions.

# Base URL for ticket QR codes (leave blank for localhost dev):
VITE_PUBLIC_TICKET_BASE_URL=

# Public deployed frontend URL for ticket/receipt links (leave blank for auto-detected origin):
VITE_PUBLIC_APP_URL=http://localhost:5173

# Backend API URL:
VITE_API_URL=http://localhost:8000

