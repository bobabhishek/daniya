APP_NAME="Garba & Dandiya Night 2026 API"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Security & CORS & Public URLs
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
ADMIN_EMAIL="teamredhawkz@gmail.com"
PUBLIC_APP_URL="http://localhost:5173" # In production: https://YOUR-DEPLOYED-DOMAIN

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID="dhandiya-hawkz"
FIREBASE_CREDENTIALS_PATH="" # Path to serviceAccountKey.json (e.g. ./serviceAccountKey.json)

# Pricing Configuration
ADULT_PRICE=299
STUDENT_PRICE=299
STUDENT_DISCOUNT_PRICE=199
STUDENT_AGE_MAX=20

# Local Receipt Storage (verified receipts are saved here: receipts/{registrationId}/payment_receipt.jpg)
RECEIPTS_DIR=receipts

# Mock Payment Setting (set to false when connecting real gateway like PhonePe)
MOCK_PAYMENT_ENABLED=true
