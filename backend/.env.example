APP_NAME="Garba & Dandiya Night 2026 API"
# Set to "production" in live deployment (enforces real Firestore, real Cloud Storage, and disables seed/mock tokens)
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"

# Security & CORS & Public URLs
# In production, set to your actual deployed frontend domain (e.g. https://taalpenachore.com)
ALLOWED_ORIGINS="https://YOUR-FRONTEND-DOMAIN.com"
ADMIN_EMAIL="teamredhawkz@gmail.com"
PUBLIC_APP_URL="https://YOUR-FRONTEND-DOMAIN.com"

# Firebase Cloud Firestore & Storage Configuration
FIREBASE_PROJECT_ID="dhandiya-hawkz"
FIREBASE_STORAGE_BUCKET="dhandiya-hawkz.firebasestorage.app"

# Service Account Credentials (choose ONE of the following for production):
# Option A: Path to mounted serviceAccountKey.json file
FIREBASE_CREDENTIALS_PATH=""
# Option B: Standard Google Application Credentials environment variable
# GOOGLE_APPLICATION_CREDENTIALS="/etc/secrets/serviceAccountKey.json"
# Option C: Raw or base64-encoded service account JSON string (ideal for Render/Railway/Heroku env vars)
FIREBASE_CREDENTIALS_JSON=""

# Pricing Configuration
ADULT_PRICE=299
STUDENT_PRICE=299
STUDENT_DISCOUNT_PRICE=199
STUDENT_AGE_MAX=20

# Local Receipt Storage Cache
RECEIPTS_DIR="receipts"
